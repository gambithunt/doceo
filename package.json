{
	"name": "doceo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "PLAYWRIGHT_BROWSERS_PATH=0 vitest --run",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
		"spike:list": "tsx experiments/generation-spike/generate.ts --list",
		"spike:generate": "node --env-file-if-exists=.env.local --import tsx experiments/generation-spike/generate.ts",
		"spike:blind": "tsx experiments/generation-spike/prepare-blind-set.ts",
		"pipeline:v2:list": "tsx experiments/generation-pipeline-v2/run.ts --list",
		"pipeline:v2:test": "vitest --run --config experiments/generation-pipeline-v2/vitest.config.ts",
		"pipeline:v2:preflight": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/preflight.ts",
		"pipeline:v2": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/run.ts",
		"pipeline:v2:compact": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/run-compact.ts",
		"pipeline:v2:plan-question": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/plan-question.ts",
		"pipeline:v2:research-question": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/research-question.ts",
		"pipeline:v2:audit-research": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/audit-research.ts",
		"pipeline:v2:narrow-research": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/narrow-research.ts",
		"pipeline:v2:plan-from-research": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/plan-from-research.ts",
		"pipeline:v2:evaluate": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/evaluate-questions.ts",
		"pipeline:v2:benchmark-reviewer": "node --env-file-if-exists=.env.local --import tsx experiments/generation-pipeline-v2/benchmark-reviewer.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openai": "^7.5.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"zod": "^4.4.3"
	}
}
