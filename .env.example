# Server-side experiment credential. Never expose this in client-side Svelte code.
MODEL_API_KEY=

# Keep provider, endpoint, model, and pricing together in the run record.
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_ID=gpt-5.4-mini
MODEL_INPUT_USD_PER_M=0.75
MODEL_CACHED_INPUT_USD_PER_M=0.075
MODEL_OUTPUT_USD_PER_M=4.5
SPIKE_MAX_RETRIES=1
